generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum RoadmapStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ResourceType {
  YOUTUBE_PLAYLIST
  VIDEO
  ARTICLE
  COURSE
  PROBLEM_SHEET
  DOCUMENTATION
  PRACTICE_PLATFORM
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskType {
  LEARN
  PRACTICE
  REVIEW
  ASSESSMENT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  displayName        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            Profile?
  learningGoals      LearningGoal[]
  progressRecords    UserProgress[]
  studySessions      StudySession[]
  dailyTasks         DailyTask[]
  assessmentAttempts AssessmentAttempt[]
  problemAttempts    ProblemAttempt[]
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredLanguage String?
  experienceLevel   String?
  dailyMinutes      Int      @default(60)
  timezone          String?
  preferences       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Goals and roadmaps use generic domain/title fields so a user can own many plans.
model LearningGoal {
  id              String         @id @default(cuid())
  userId          String
  title           String
  domain          String
  description     String?
  targetDate      DateTime?
  status          GoalStatus     @default(DRAFT)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps        Roadmap[]
  progressRecords UserProgress[]

  @@index([userId, status])
}

model Roadmap {
  id               String         @id @default(cuid())
  learningGoalId   String
  title            String
  description      String?
  status           RoadmapStatus  @default(DRAFT)
  version          Int            @default(1)
  estimatedMinutes Int?
  settings         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  learningGoal     LearningGoal   @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  modules          Module[]
  progressRecords  UserProgress[]

  @@index([learningGoalId, status])
}

model Module {
  id          String       @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  position    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roadmap     Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]
  assessments Assessment[]

  @@unique([roadmapId, position])
}

model Topic {
  id                       String              @id @default(cuid())
  moduleId                 String
  slug                     String              @unique
  title                    String
  description              String?
  difficulty               Difficulty
  position                 Int
  estimatedLearningMinutes Int
  estimatedPracticeMinutes Int
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  module                   Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisites            TopicPrerequisite[] @relation("TopicPrerequisiteTopic")
  unlocks                  TopicPrerequisite[] @relation("TopicPrerequisitePrerequisite")
  resources                ResourceTopic[]
  problems                 Problem[]
  assessments              Assessment[]
  topicProgress            TopicProgress[]
  studySessions            StudySession[]
  dailyTasks               DailyTask[]

  @@unique([moduleId, position])
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String
  topic          Topic  @relation("TopicPrerequisiteTopic", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   Topic  @relation("TopicPrerequisitePrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([topicId, prerequisiteId])
}

model Resource {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  type        ResourceType
  url         String
  provider    String?
  isDemo      Boolean         @default(true)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  topics      ResourceTopic[]
}

model ResourceTopic {
  resourceId      String
  topicId         String
  position        Int      @default(0)
  sectionMetadata Json?
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([resourceId, topicId])
  @@index([topicId, position])
}

model Problem {
  id               String           @id @default(cuid())
  topicId          String
  slug             String           @unique
  title            String
  description      String?
  difficulty       ProblemDifficulty
  subtopic         String?
  estimatedMinutes Int
  url              String?
  platform         String?
  tags             String[]
  starterCode      Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  topic            Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts         ProblemAttempt[]
}

model Assessment {
  id               String              @id @default(cuid())
  moduleId         String?
  topicId          String?
  slug             String              @unique
  title            String
  description      String?
  passingScore     Int                 @default(70)
  estimatedMinutes Int                 @default(15)
  isPublished      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  module           Module?             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topic            Topic?              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions        Question[]
  attempts         AssessmentAttempt[]

  @@index([topicId])
}

model Question {
  id            String       @id @default(cuid())
  assessmentId  String
  position      Int
  prompt        String
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json?
  correctAnswer Json
  explanation   String?
  points        Int          @default(1)
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, position])
}

model UserProgress {
  id             String          @id @default(cuid())
  userId         String
  learningGoalId String?
  roadmapId      String
  status         ProgressStatus  @default(NOT_STARTED)
  completion     Int             @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningGoal   LearningGoal?   @relation(fields: [learningGoalId], references: [id], onDelete: SetNull)
  roadmap        Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics         TopicProgress[]
  studySessions  StudySession[]
  dailyTasks     DailyTask[]

  @@unique([userId, roadmapId])
  @@index([userId, learningGoalId])
}

model TopicProgress {
  id               String         @id @default(cuid())
  userProgressId   String
  topicId          String
  status           ProgressStatus @default(NOT_STARTED)
  completion       Int            @default(0)
  assessmentScore  Int?
  practiceAccuracy Int?
  timeSpentMinutes Int            @default(0)
  mistakes         Int            @default(0)
  lastActivityAt   DateTime?
  completedAt      DateTime?
  userProgress     UserProgress   @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userProgressId, topicId])
  @@index([topicId])
}

model StudySession {
  id              String        @id @default(cuid())
  userId          String
  userProgressId  String?
  topicId         String?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  durationMinutes Int           @default(0)
  notes           String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProgress    UserProgress? @relation(fields: [userProgressId], references: [id], onDelete: SetNull)
  topic           Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

model DailyTask {
  id               String         @id @default(cuid())
  userId           String
  userProgressId   String?
  topicId          String?
  title            String
  description      String?
  type             TaskType
  dueDate          DateTime
  estimatedMinutes Int            @default(30)
  status           ProgressStatus @default(NOT_STARTED)
  position         Int            @default(0)
  metadata         Json?
  completedAt      DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProgress     UserProgress?  @relation(fields: [userProgressId], references: [id], onDelete: SetNull)
  topic            Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate, status])
}

model AssessmentAttempt {
  id           String        @id @default(cuid())
  userId       String
  assessmentId String
  status       AttemptStatus @default(IN_PROGRESS)
  score        Int?
  maxScore     Int?
  answers      Json?
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
}

model ProblemAttempt {
  id              String        @id @default(cuid())
  userId          String
  problemId       String
  status          AttemptStatus @default(IN_PROGRESS)
  isSolved        Boolean       @default(false)
  language        String?
  solution        String?
  notes           String?
  durationMinutes Int           @default(0)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}
